# VivaIQ Environment Configuration

# Application
PROJECT_NAME="VivaIQ"
ENVIRONMENT="development"   # development | production | testing
DEBUG=true
# DEMO_MODE permits the mock LLM/STT below so the app runs with no GPU or API keys.
# Set false (and pick real providers) for real use; production refuses DEMO_MODE=true.
DEMO_MODE=true
API_V1_STR="/api/v1"
# Explicit origins only; "*" is rejected at startup.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Placeholder/empty -> random key per restart in dev (everyone is logged out); refused in production.
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Privacy: recordings of completed/cancelled sessions older than this are deleted daily.
AUDIO_RETENTION_DAYS=30

# Database
DATABASE_URL="sqlite+aiosqlite:///./vivaiq.db"

# Storage Paths
DATA_DIR="./data"
AUDIO_STORAGE_PATH="./data/audio"
DOCUMENT_STORAGE_PATH="./data/documents"
CHROMA_PERSIST_PATH="./data/chromadb"

# LLM Gateway
# Options: ollama | gemini | grok | mock
LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GROK_API_KEY=""
GROK_MODEL="grok-beta"

# STT Configuration
# Options: whisper | mock
STT_PROVIDER="mock"
WHISPER_MODEL="base.en"
WHISPER_DEVICE="cuda"
WHISPER_COMPUTE_TYPE="float16"   # int8 for CPU
WHISPER_LANGUAGE="en"            # or "auto" to detect
WHISPER_BEAM_SIZE=1

# TTS Configuration
# Options: browser | edge | piper | mock   (kokoro is not implemented yet; falls back to browser)
TTS_PROVIDER="browser"
PIPER_MODEL_PATH=""                       # path to a Piper .onnx voice (its .onnx.json must sit beside it)
EDGE_TTS_VOICE="en-US-JennyNeural"        # e.g. en-IN-NeerjaNeural for Indian English

# PDF reports: Unicode .ttf font (a "<name>-Bold.ttf" beside it is used for headings).
# Empty = auto-detect DejaVu (Linux/Docker) or Arial (Windows). Neither covers Devanagari:
# for Hindi transcripts point this at e.g. NotoSansDevanagari-Regular.ttf.
PDF_FONT_PATH=""

# RAG & Embeddings
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
TOP_K_RETRIEVAL=4

# Viva Session Defaults
MIN_QUESTIONS=6
MAX_QUESTIONS=10
