# VivaIQ Environment Configuration

# Application
PROJECT_NAME="VivaIQ"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="sqlite+aiosqlite:///./vivaiq.db"

# Storage Paths
DATA_DIR="./data"
AUDIO_STORAGE_PATH="./data/audio"
DOCUMENT_STORAGE_PATH="./data/documents"
CHROMA_PERSIST_PATH="./data/chromadb"

# LLM Gateway
# Options: ollama | gemini | grok | mock
LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GROK_API_KEY=""
GROK_MODEL="grok-beta"

# STT Configuration
# Options: whisper | mock
STT_PROVIDER="mock"
WHISPER_MODEL="base.en"
WHISPER_DEVICE="cuda"
WHISPER_COMPUTE_TYPE="float16"

# TTS Configuration
# Options: browser | piper | kokoro | mock
TTS_PROVIDER="browser"
PIPER_MODEL_PATH=""

# RAG & Embeddings
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
TOP_K_RETRIEVAL=4

# Viva Session Defaults
MIN_QUESTIONS=6
MAX_QUESTIONS=10
