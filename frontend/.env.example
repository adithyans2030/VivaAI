# Copy to frontend/.env.local (Vite only exposes variables prefixed with VITE_)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# Shows one-click demo account buttons on /login. Leave false for real deployments:
# when true, the demo passwords are included in the public JavaScript bundle.
VITE_DEMO_MODE=false
