# Copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Shows one-click demo account buttons on /login. Leave false for real deployments:
# when true, the demo passwords are included in the public JavaScript bundle.
NEXT_PUBLIC_DEMO_MODE=false
